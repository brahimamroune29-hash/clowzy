# Public URL of the platform (production). Without it the API only answers on 127.0.0.1/localhost.
# Set it before `npm run build` too: security headers are compiled at build time.
# APP_URL=https://your-domain.com

# Optional database path. Default: .data/wasl.sqlite
# WASL_DB_PATH=

# Server-only Icypeas key (people search + email discovery). Never expose it as NEXT_PUBLIC_.
ICYPEAS_API_KEY=
