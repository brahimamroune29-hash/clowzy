# Public URL of the platform (production). Without it the API only answers on 127.0.0.1/localhost.
# Set it before `npm run build` too: security headers are compiled at build time.
# APP_URL=https://your-domain.com

# Postgres for the app role, through the Supabase transaction pooler (port 6543). See README: قاعدة البيانات.
DATABASE_URL=

# Server-only Icypeas key (people search + email discovery). Never expose it as NEXT_PUBLIC_.
ICYPEAS_API_KEY=

# Server-only OpenRouter key: maps a sector or job title typed under «أخرى» to the provider's names (Claude Haiku). Optional.
OPENROUTER_API_KEY=

# Supplement exhausted company results with cited official websites in the same city.
# Opt-in after a live coverage check. At most 6 discovery pages/search, 12/member/day.
# Only one-country searches without an employee-count filter qualify.
WEB_DISCOVERY_ENABLED=false
PUBLISHED_EMAIL_ENABLED=false

# Optional secondary-source pilot only (scripts/check-secondary-coverage.ts).
# Not wired into customer searches. Keep disabled until a real coverage trial passes.
HUNTER_API_KEY=
HUNTER_ENABLED=false

# Apply supabase/migrations/20261002095426_crm_catalog.sql first. Server-only switches.
CRM_ENABLED=false
# Keep false until supplier licensing explicitly permits cross-account reuse.
CATALOG_REUSE_ENABLED=false
CATALOG_FRESH_DAYS=30
# Optional USD unit rates; blank means unknown, not zero. Estimates are not actual revenue/profit.
CRM_FETCH_COST_USD=
CRM_SUBMIT_COST_USD=
CRM_CREDIT_VALUE_USD=

# Owner's lock. Set to 1 (or true) and the API answers nothing but the lock message: browser requests and
# the search worker alike, so a locked platform stops spending on paid provider batches. Clear it (or set 0)
# to restore. No data is touched either way, and the nightly backup keeps running — it reaches the database
# directly, not through the API. On the host, changing it takes effect on the next deploy.
PLATFORM_LOCKED=0

# Private bearer token (at least 32 random characters) for the search worker.
# Supabase Cron reads the same value from Vault; see README.
CRON_SECRET=
